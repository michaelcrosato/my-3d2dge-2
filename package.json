{
  "name": "3dpixel2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-operated demo: live-rendered 3D characters that read as pixel-art sprites (three.js r186 + Rapier 0.20). See AGENTS.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run test",
    "assets": "node tools/build-assets.mjs",
    "build:standalone": "node node_modules/typescript/bin/tsc --noEmit && node tools/build-standalone.mjs",
    "verify:standalone": "python3 tools/verify-standalone.py",
    "test": "vitest run",
    "agent": "node tools/agent-cli.mjs",
    "mcp": "node tools/mcp-server.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "0.186.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
